# Public browser config. npm run dev uses demo; npm run dev:sandbox selects sandbox.
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Copy the local publishable/anon key from npm run db:status; never service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required only for a dedicated remote Supabase test project (VITE_APP_ENV=sandbox).
VITE_SUPABASE_PROJECT_REF=
VITE_FACE_DETECTION_MIN_CONFIDENCE=0.8
VITE_GOOGLE_MAPS_EMBED_KEY=

# Store provider secrets in ignored supabase/functions/.env, never VITE_*.
