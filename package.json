{
  "name": "rkmed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public,private --level warning",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local",
    "stripe:init": "node scripts/stripe/sandbox.mjs init",
    "stripe:doctor": "node scripts/stripe/sandbox.mjs doctor",
    "stripe:bootstrap": "node scripts/stripe/sandbox.mjs bootstrap",
    "stripe:checkout": "node scripts/stripe/sandbox.mjs checkout",
    "stripe:invoice": "node scripts/stripe/sandbox.mjs invoice",
    "stripe:webhook": "node scripts/stripe/webhook.mjs",
    "stripe:test": "node --test tests/stripe/*.test.mjs",
    "dev": "vite --host 127.0.0.1 --mode sandbox",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "tsc -b && vite build --mode sandbox",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "build:hosted": "tsc -b && vite build --mode hosted",
    "preview": "vite preview --host 127.0.0.1 --mode sandbox",
    "typecheck": "tsc -b && tsc -p tsconfig.providers.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/integrations/*.test.mjs tests/stripe/*.test.mjs",
    "test:e2e": "node tests/flows.mjs",
    "test:mobile": "node tests/mobile-layout.mjs",
    "dev:sandbox": "vite --host 127.0.0.1 --port 5174 --mode sandbox",
    "build:sandbox": "tsc -b && vite build --mode sandbox --outDir dist-sandbox",
    "local:prepare": "node scripts/dev/prepare.mjs",
    "local:fixtures": "node scripts/dev/fixtures.mjs",
    "functions:serve": "supabase functions serve --env-file .env.test",
    "test:connected:api": "node tests/connected/api.mjs",
    "test:connected:ui": "node tests/connected/ui.mjs",
    "test:connected:edge": "node tests/connected/edge.mjs",
    "test:connected:enrollment": "node tests/connected/enrollment.mjs",
    "test:connected:offline": "node tests/connected/offline.mjs",
    "test:connected:reports": "node tests/connected/reports.mjs",
    "test:connected:operational": "node tests/connected/operational.mjs",
    "test:connected:pagination": "node tests/connected/pagination.mjs",
    "test:performance": "node tests/connected/performance.mjs",
    "env:init": "node scripts/env/init.mjs",
    "build:prod": "tsc -b && vite build --mode prod"
  },
  "devDependencies": {
    "@stripe/cli": "1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow-models/blazeface": "0.1.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jpeg-js": "0.4.4",
    "playwright-core": "^1.63.0",
    "standardwebhooks": "1.1.1",
    "stripe": "23.0.0",
    "supabase": "2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
