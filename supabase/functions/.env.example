# Backend adapters are not deployed or called automatically by the UI.
APP_ENV=local
STRIPE_SECRET_KEY=
STRIPE_TEST_ACCOUNT_ID=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_ORIGIN=http://127.0.0.1:5174

# Disabled by default. This is Twilio Programmable Messaging's WhatsApp Sandbox,
# not Verify test credentials. Sending requires a joined, explicitly allowed test number.
TWILIO_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ALLOWED_TEST_NUMBERS=

# Customer Portal: fixed plan, no upgrades, cancellation only at_period_end.
STRIPE_PORTAL_CONFIGURATION_ID=
# Standard Webhooks signing secrets generated for the Supabase Auth hooks.
AUTH_SMS_HOOK_SECRET=
AUTH_EMAIL_HOOK_SECRET=
TWILIO_SMS_FROM=
RESEND_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALLOWED_TEST_EMAILS=
OPERATIONS_TEST_EMAIL=
# Private job bearer token; never a VITE variable. Generate >=32 random bytes.
JOBS_SECRET=
