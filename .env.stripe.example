# Server-side development tooling only. Never copy these variables into VITE_*.
# Separate Stripe sandboxes/account IDs and credentials for local, ci and staging.
STRIPE_TEST_ENV=local
# Expected sandbox account (acct_...). Required before any remote API operation.
STRIPE_TEST_ACCOUNT_ID=
# Prefer a restricted TEST key (rk_test_...), configured only in ignored files.
STRIPE_SECRET_KEY=
# From Stripe CLI listen for THIS sandbox/listener. Never commit the value.
STRIPE_WEBHOOK_SECRET=
# Loopback only; the receiver defaults to port 4242.
STRIPE_TEST_ORIGIN=http://127.0.0.1:4242
